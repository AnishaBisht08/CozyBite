<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CozyBite" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>

    </style>


    <style name="Theme.CozyBite.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/cozybite_logo</item>
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="postSplashScreenTheme">@style/Theme.CozyBite</item>

    </style>
</resources>